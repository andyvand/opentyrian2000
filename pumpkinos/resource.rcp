#include "resource.h"

MENU MainMenu
BEGIN
  PULLDOWN "Game"
  BEGIN
    MENUITEM "About" menuAbout "A"
    MENUITEM "Quit"  menuQuit  "Q"
  END
END

FORM MainForm 0 0 160 160
USABLE
NOFRAME
MENUID MainMenu
BEGIN
  TITLE "OpenTyrian 2000"
END

ICONFAMILY "opentyrian.bmp" "" "" "opentyrian.bmp" TRANSPARENT 0 255 0

/* requested window size in pixels: 640 x 430 (title bar + 2x the 320x200 game screen; PumpkinOS clamps it to the display and takes its window border off, the game is then scaled to fit) */
HEX "wind" ID 1
  0x02 0x80 0x01 0xAE

VERSION "1.0"

/* the bundled Tyrian 2000 data files (generated by gen_data.sh) */
#include "gen/data.rcp"
